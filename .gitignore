# ==============================================================================
# Environment Variables & Secrets (NEVER COMMIT SENSITIVE DATA)
# ==============================================================================
.env
.env.*
*.env
*.local
*.key
*.pem
*.cert
*.crt
*.pfx
secrets.*

# Always allow commit of example / template environment files
!.env.example
!.env.*.example

# ==============================================================================
# Python / Backend
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Coverage & Linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Node.js / Vite / React / Frontend
# ==============================================================================
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/**
.nitro/
.cache/
.vite/
.next/
.nuxt/

# Package manager logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# ==============================================================================
# Databases & Local Data Stores
# ==============================================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Supabase local generated / temporary states
supabase/.temp/
supabase/.branches/

# ==============================================================================
# Archive / Compressed Files (Prevent uploading bulky archives)
# ==============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ==============================================================================
# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==============================================================================
# IDEs & Text Editors
# ==============================================================================
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
